= render "shared/hero"
#hikes
.section.my-5
  = render "shared/sort"
  / = render "shared/filters"
  .container.mt-4
    - if @hikes.any?
      .row
        = render partial: "shared/card_column", collection: @hikes, as: :hike
      - if @pagy.pages > 1
        == pagy_bootstrap_nav(@pagy).html_safe
    - else
      h3 = t('.not_found')
      p = t('.no_results_try_different_keywords')

= content_for(:after_js) do
  = javascript_include_tag "filters"
