div class="col-md-6 col-lg-4"
  = link_to hike_path(hike), class: "card mb-4 shadow-sm" do
    - if hike.image_identifier.present?
      figure.card__img.card-img-top
        img class="lazyload" alt="#{hike.name}" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="#{hike.image.thumb.url}"
    - else
      svg class="card-img-top" width="100%" height="180" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" focusable="false" role="img" aria-label="#{hike.name}"
        rect width="100%" height="100%" fill="#868e96"

    .card-body
      h5 class="card-title" = hike.name
      p class="card-subtitle mb-2 text-muted"
        .d-flex.flex-wrap.align-items-center
          div
            i.far.fa-calendar.text-primary
            span.mx-2 = hike.date
          div.ms-2
            - if hike.skiing?
              i.fas.fa-skiing-nordic.text-primary
            - else
              i.fas.fa-hiking.text-primary
            span.mx-2 = "#{hike.distance} км"
      p class="card-text"
        = truncate(hike.description, length: 100)