{
  "name": "xodoki",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.js",
    "build:css:dev": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules && yarn copy:fonts",
    "copy:fonts": "mkdir -p app/assets/builds && cp -r node_modules/@fortawesome/fontawesome-free/webfonts/* app/assets/builds/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@rails/activestorage": "^7.2.0",
    "@rails/ujs": "^7.1",
    "@tmcw/togeojson": "^7.1.3",
    "bootstrap": "^4.3.1",
    "esbuild": "^0.25.0",
    "jquery": "^3.5.0",
    "lazysizes": "^5.2.1",
    "popper.js": "^1.14.4",
    "sass": "^1.108.2",
    "trix": "^2.1.19"
  }
}
